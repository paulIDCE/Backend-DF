<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BackendDF</RootNamespace>
    <UserSecretsId>plantilla-api-idce-0001</UserSecretsId>
    <!-- Los comentarios XML de los controllers alimentan Swagger. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;1573</NoWarn>
    <!-- Workstation GC: con los datos en memoria el Server GC retiene >1,8 GB; así queda en ≈ 450 MB
         con la caché de entidades llena (meta del contrato §12: < 1,5 GB). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Autenticación: validación del JWT (Supabase hoy, SSO propio después) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.14" />

    <!-- Swagger / OpenAPI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />

    <!-- Fuente SQL (idce_bco_coop): ADO.NET sobre los procedimientos del esquema api -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mapa slug del backend → IFIID/RUC de la BD (vive en el backend, no en la BD). -->
    <Content Update="Data\FuenteSql\mapa-entidades.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- La "BD" JSON (≈ 2,5 GB) se lee desde disco: no se copia a bin/publish ni se sirve como estática. -->
    <Content Remove="Database\**" />
    <None Remove="Database\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BackendDF.Tests" />
  </ItemGroup>

</Project>
