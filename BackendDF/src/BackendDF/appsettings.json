{
  // Fuente de datos JSON (contrato §3). RutaBase puede ser absoluta o relativa a la raíz del proyecto.
  "Datos": {
    "RutaBase": "Database",
    "MaxEntidadesEnCache": 40,

    // Fuente híbrida SQL + JSON (docs/informe-sav-a-sql.md §8, scripts en db/fase0).
    // Habilitado=false: la API funciona solo con los JSON.
    "Sql": {
      "Habilitado": true,
      "ConnectionStringName": "DefaultConnection",
      "TimeoutSegundos": 60,
      "MinutosRevisionVentana": 10,
      "SegundosCircuitoAbierto": 60,
      "RutaMapaEntidades": "Data/FuenteSql/mapa-entidades.json"
      // Qué cuadros, filas, fórmulas y fechas: lo define el catálogo de la BD (db/fase2).
      // Sin catálogo se usan los valores por defecto de Data/FuenteSql/ReglasCuadro.cs.
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=192.168.1.5;Database=idce_bco_coop;TrustServerCertificate=true;user ID=sa;pwd=bD@2019;"
  },

