{
  // Fuente de datos JSON (contrato §3). RutaBase puede ser absoluta o relativa a la raíz del proyecto.
  "Datos": {
    "RutaBase": "Database",
    "MaxEntidadesEnCache": 40
  },

  // Validación del access token (contrato §4.2). Hoy Supabase; para el SSO propio basta cambiar
  // Issuer/JwksUrl/Audience (o Secreto si firma con HS256), sin tocar los endpoints.
  // Secreto (HS256, proyectos Supabase antiguos) va por user-secrets:
  //   dotnet user-secrets set "Auth:Secreto" "<jwt secret del proyecto>"
  "Auth": {
    "Habilitada": true,
    "Modo": "Supabase",
    "Issuer": "https://mxpseuoksbrqsecukqou.supabase.co/auth/v1",
    "JwksUrl": "https://mxpseuoksbrqsecukqou.supabase.co/auth/v1/.well-known/jwks.json",
    "Audience": "authenticated",
    "Secreto": ""
  },

  "Cors": {
    "Origenes": [
      "http://localhost:3000",
      "http://localhost:3002",
      "http://localhost:51646"
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
