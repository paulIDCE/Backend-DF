{
  // Fuente de datos JSON (contrato §3). RutaBase puede ser absoluta o relativa a la raíz del proyecto.
  "Datos": {
    "RutaBase": "Database",
    "MaxEntidadesEnCache": 40,

    // Fuente híbrida SQL + JSON (docs/informe-sav-a-sql.md §8, scripts en db/fase0).
    // Habilitado=false: la API funciona solo con los JSON.
    "Sql": {
      "Habilitado": true,
      "ConnectionStringName": "DefaultConnection",
      "TimeoutSegundos": 60,
      "MinutosRevisionVentana": 10,
      "SegundosCircuitoAbierto": 60,
      "RutaMapaEntidades": "Data/FuenteSql/mapa-entidades.json",
      // Filas de cuenta (y indicadores de EFI05) que se leen de SQL.
      "CuadrosSql": [ "EFI01", "EFI02", "EFI05", "EFI06", "EFI07", "EFI10", "REP01",
                      "SFN01", "SFN02", "SFN03", "SFN04", "SFN05", "SFN06", "SFN07", "SFN08" ],
      // No salen del .sav: conservan las fechas del JSON (los macro siempre).
      "CuadrosFechasJson": [ "EFI09", "TPE02", "CAR03" ],
      // Convención C2: grupos que no están en la BD.
      "GruposOmitidos": [ "6", "7" ]
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=192.168.1.5;Database=idce_bco_coop;TrustServerCertificate=true;user ID=sa;pwd=bD@2019;"
  },

  // Validación del access token (contrato §4.2). Hoy Supabase; para el SSO propio basta cambiar
  // Issuer/JwksUrl/Audience (o Secreto si firma con HS256), sin tocar los endpoints.
  // Secreto (HS256, proyectos Supabase antiguos) va por user-secrets:
  //   dotnet user-secrets set "Auth:Secreto" "<jwt secret del proyecto>"
  "Auth": {
    "Habilitada": true,
    "Modo": "Supabase",
    "Issuer": "https://mxpseuoksbrqsecukqou.supabase.co/auth/v1",
    "JwksUrl": "https://mxpseuoksbrqsecukqou.supabase.co/auth/v1/.well-known/jwks.json",
    "Audience": "authenticated",
    "Secreto": ""
  },

  "Cors": {
    "Origenes": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:3002",
      "http://localhost:51646"
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
